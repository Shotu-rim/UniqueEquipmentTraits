<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>UET_MindCleansingParalysis</defName>
        <label>mind cleansing paralysis</label>
        <description>The brain has temporarily shut down its motor functions to purge accumulated neural heat. The affected person is completely immobilized until neural activity stabilizes.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <preventsCrawling>true</preventsCrawling>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1200</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <setMax>0</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>
