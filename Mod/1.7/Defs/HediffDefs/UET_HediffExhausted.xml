<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>UET_Exhausted</defName>
    <label>exhausted</label>
    <description>Severe exhaustion following an Overdrive activation. Reduces movement and manipulation capacity.</description>
    <hediffClass>UniqueEquipmentTraits.Effects.Hediff_Exhausted</hediffClass>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>masterwork</label>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.40</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.40</offset></li>
        </capMods>
      </li>
      <li>
        <label>legendary</label>
        <minSeverity>0.5</minSeverity>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.30</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.30</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
