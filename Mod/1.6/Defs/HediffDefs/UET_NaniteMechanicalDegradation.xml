      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties">
        <compClass>UniqueEquipmentTraits.Implants.HediffComp_NaniteDamage</compClass>
      </li>
    </comps>
  </HediffDef>
</Defs>
